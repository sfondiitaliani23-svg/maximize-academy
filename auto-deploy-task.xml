<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Auto-deploy Maximize Academy: monitora modifiche e fa git push automatico verso Vercel.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>false</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "c:\Users\Eliseo Miraglia\Desktop\LAVORO\MAXIMIZE ACADEMY SITO\MAXIMIZE_ACADEMY_PROGETTO_COMPLETO\auto-deploy-launcher.bat"</Arguments>
      <WorkingDirectory>c:\Users\Eliseo Miraglia\Desktop\LAVORO\MAXIMIZE ACADEMY SITO\MAXIMIZE_ACADEMY_PROGETTO_COMPLETO</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
