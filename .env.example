# ========================================================
# MAXIMIZE ACADEMY — ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================
# Copia questo file in .env per lo sviluppo locale
# o configuralo nelle Environment Variables della dashboard Vercel.

# [Server API locale]
# Porta di server/index.js. Vite (porta 5173) inoltra /api qui.
PORT=3001
NODE_ENV=development

# [Dominio Piattaforma]
VITE_SITE_URL=https://maximize-academy.vercel.app

# [Email Notifiche Lead via Resend (Opzionale)]
# Ottieni la chiave gratuita su https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Mittente delle email. Serve un dominio verificato su Resend.
# Senza, si usa onboarding@resend.dev e le email arrivano solo al proprietario dell'account Resend.
# RESEND_FROM=Maximize Academy <lead@tuodominio.it>

# [Destinatari Notifiche Lead]
# Inserisci gli indirizzi email (separati da virgola se multipli)
NOTIFICATION_EMAIL=mauriziomaximize@gmail.com,eliseeshop.official@gmail.com
